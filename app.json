{
  "expo": {
    "name": "DS,P",
    "slug": "dead-simple-player",
    "owner": "eric-helal-apps",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "deadsimpleplayer",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "DS,P uses your local network to connect to your media server and stream your channels."
      },
      "bundleIdentifier": "com.rabsefbicrym.dsp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.rabsefbicrym.dsp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "DS,P",
      "shortName": "DS,P",
      "themeColor": "#120a05",
      "backgroundColor": "#120a05"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
